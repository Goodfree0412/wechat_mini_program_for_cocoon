page {
  background-color: #fff5f7;
}

.container {
  padding: 30rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.label {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 10rpx;
  display: block;
}

.input-box {
  width: 100%;
  height: 80rpx;
  background-color: white;
  border-radius: 15rpx;
  padding: 0 25rpx;
  font-size: 28rpx;
  border: 2rpx solid #eee;
  box-sizing: border-box;
}

.textarea-box {
  width: 100%;
  min-height: 150rpx;
  background-color: white;
  border-radius: 15rpx;
  padding: 20rpx 25rpx;
  font-size: 28rpx;
  border: 2rpx solid #eee;
  box-sizing: border-box;
}

.map-container {
  width: 100%;
  height: 400rpx;
  background-color: white;
  border-radius: 15rpx;
  overflow: hidden;
  margin-top: 15rpx;
}

.map-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  text-align: center;
}

.summary-box {
  background-color: white;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 30rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
  font-size: 28rpx;
  color: #555;
}

.summary-row:last-child {
  margin-bottom: 0;
}

.total-price {
  font-size: 36rpx;
  color: #ff6b81;
  font-weight: bold;
}

.pay-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(to right, #ffb6c1, #ff9eb5);
  border-radius: 45rpx;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(255, 182, 193, 0.4);
}

.pay-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.price-detail {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 15rpx;
}
